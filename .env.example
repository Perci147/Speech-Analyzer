# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini models (defaults: gemini-3.6-flash, falling back to gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# --- Accounts (optional) ---------------------------------------------------
# Without these, the app runs guest-only and saves sessions in the browser.
# Supabase dashboard -> Project Settings -> API Keys (and Data API for the URL).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Server-only secret key, used for daily usage limits. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Optional: daily analyses per guest (per IP) and per signed-in user.
# DAILY_LIMIT_GUEST=3
# DAILY_LIMIT_USER=20
